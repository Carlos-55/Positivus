---
import PDF from '../../assets/data_signature/documento_1.pdf';
---

<div>
    <p class="text-bold text-xl" >Firma simple</p>
    <div>
        <p>En esta sección se podrá probar la firma simple.</p>
        <div>
            <h3>Preview del PDF</h3>
            <div style="height: 500px;">
                <iframe src={PDF + '#page=1&zoom=100'} width="100%" height="100%"></iframe>
            </div>
        </div>
        <div class="mt-6">
            <h3>Estructura del JSON</h3>
            <!-- Dale un estilo amigable a este json para que sea mas sencilla la lectura -->
            <!-- <pre id="json-signature"></pre> -->
            <div class="mt-4">
                <pre id="json-signature" class="whitespace-pre-wrap break-words p-4 bg-gray-100 rounded-lg text-sm text-gray-800"></pre>
            </div>
        </div>
    </div>
</div>

<script>
    import JSONData from '../../assets/data_signature/1F_1D.json';

    const jsonSignature = {};
    Object.assign(jsonSignature, JSONData);
    document.getElementById('json-signature')!.textContent = JSON.stringify(jsonSignature, null, 2);
</script>